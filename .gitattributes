# 줄바꿈(EOL) 정규화 설정
#
# 저장소에는 LF로 저장하고, 체크아웃 시 각 OS에 맞는 줄바꿈으로 변환합니다.
# 이렇게 하면 Windows에서 작업하고 macOS/Linux에서 클론해도
# 파일 전체가 변경된 것처럼 보이는 diff가 발생하지 않습니다.

* text=auto

# ── 텍스트 파일 명시 ─────────────────────────────
*.py     text diff=python
*.md     text
*.json   text
*.jsonl  text
*.csv    text
*.toml   text
*.lock   text
*.txt    text
*.cfg    text
*.yml    text
*.yaml   text

# ── 윈도우 전용 스크립트는 CRLF 유지 ──────────────
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# ── 셸 스크립트는 LF 유지 (실행 호환성) ───────────
*.sh     text eol=lf

# ── 바이너리 파일 (diff/병합 대상 제외) ───────────
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.xlsx   binary
*.zip    binary
*.gguf   binary
